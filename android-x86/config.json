{
  "name": "Android APK",
  "version": "2.0.5",
  "slug": "android-x86-emulator",
  "description": "Lightweight Android APK runner powered by ApkStart container trimming, Quickboot snapshots, drag-and-drop APK installer, noVNC Ingress, and ADB",
  "url": "https://github.com/PiexlPuck/APK-HA",
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8099,
  "panel_title": "Android",
  "panel_icon": "mdi:android",
  "ports": {
    "5555/tcp": 5555
  },
  "devices": [
    "/dev/kvm:/dev/kvm"
  ],
  "options": {
    "memory": 1536,
    "cores": 2,
    "quickboot": true,
    "deep_trim": true,
    "idle_park_minutes": 10,
    "force_reinstall": false
  },
  "schema": {
    "memory": "int(512,8192)",
    "cores": "int(1,8)",
    "quickboot": "bool",
    "deep_trim": "bool",
    "idle_park_minutes": "int(0,120)",
    "force_reinstall": "bool"
  },
  "arch": ["amd64"],
  "privileged": ["SYS_ADMIN"]
}
